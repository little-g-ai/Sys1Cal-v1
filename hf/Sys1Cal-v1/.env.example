# Hugging Face upload settings for Sys1Cal-v1.
# Copy to .env and fill in the values:
# cp .env.example .env

# Required: create a token at https://huggingface.co/settings/tokens
# Scope needed: write access.
HF_TOKEN=

# Required: target dataset repository id.
# Examples:
# HF_REPO_ID=RiccardoPorcedda/Sys1Cal-v1
# HF_REPO_ID=your-org/Sys1Cal-v1
HF_REPO_ID=

# Dataset repos must use this type.
HF_REPO_TYPE=dataset

# Set to true for an initial private upload, false for public.
HF_PRIVATE=false

# Local folder to upload.
HF_LOCAL_PATH=.

# Upload destination inside the repo. "." means repository root.
HF_PATH_IN_REPO=.

# Commit metadata.
HF_COMMIT_MESSAGE=Add Sys1Cal-v1 dataset benchmark
HF_COMMIT_DESCRIPTION=Adds benchmark JSONL files, evaluator, examples, dataset card, and citation metadata for Sys1Cal-v1.

